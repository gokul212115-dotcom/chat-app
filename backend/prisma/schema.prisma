// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  phoneNumber   String    @unique
  email         String?   @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  statusMessage String?
  isOnline      Boolean
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations Conversation[]
  contacts      Contact[]
}

model Contact {
  id           Int       @id @default(autoincrement())
  ownerId      Int
  contactUser  User      @relation(fields: [contactUserId], references: [id])
  contactUserId Int
  createdAt    DateTime  @default(now())

  @@unique([ownerId, contactUserId])
}

model Conversation {
  id                Int                 @id @default(autoincrement())
  isGroup           Boolean
  groupName         String?
  groupAvatarUrl    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  participants      ConversationParticipant[]
  messages          Message[]
}

model ConversationParticipant {
  id              Int       @id @default(autoincrement())
  conversationId  Int
  userId          Int
  role            Role      @default(MEMBER)
  joinedAt        DateTime  @default(now())
  isMuted         Boolean   @default(false)
  isArchived      Boolean   @default(false)

  user            User      @relation(fields: [userId], references: [id])
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id                Int       @id @default(autoincrement())
  conversationId    Int
  senderId          Int
  content           String?
  messageType       MessageType @default(TEXT)
  replyToMessageId  Int?
  isEdited          Boolean   @default(false)
  isDeletedForEveryone Boolean @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversation      Conversation @relation(fields: [conversationId], references: [id])
  sender            User       @relation(fields: [senderId], references: [id])
  replyToMessage    Message?   @relation("replyTo", fields: [replyToMessageId], references: [id])

  @@unique([conversationId, replyToMessageId])
}

model MessageStatus {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  status    Status   @default(SENT)
  updatedAt DateTime @updatedAt

  message User @relation(fields: [messageId], references: [id])
  user    User @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message User @relation(fields: [messageId], references: [id])
  user    User @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model MediaAttachment {
  id            Int       @id @default(autoincrement())
  messageId     Int
  url           String
  mimeType      String
  sizeBytes     Int
  durationSeconds Float?

  message Message @relation(fields: [messageId], references: [id])

  @@unique([messageId, url])
}

enum Role {
  MEMBER
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum Status {
  SENT
  DELIVERED
  READ
}
